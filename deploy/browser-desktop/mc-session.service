[Unit]
Description=MediaCrawler desktop session (openbox + Chrome CDP + Sunshine) on :1
After=mc-xorg.service
Requires=mc-xorg.service

[Service]
User=jingxuan
Group=jingxuan
Environment=DISPLAY=:1
Environment=XAUTHORITY=/run/mc-xauth
Environment=HOME=/home/jingxuan
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -S /tmp/.X11-unix/X1 ] && exit 0; sleep 1; done; exit 1'
ExecStart=/home/jingxuan/.mc-desktop/session-run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
