[Unit]
Description=noVNC (websockify) for MediaCrawler desktop
After=mc-x11vnc.service
Requires=mc-x11vnc.service

[Service]
User=jingxuan
Group=jingxuan
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 0.0.0.0:6080 localhost:5900
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
